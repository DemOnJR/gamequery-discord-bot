# ---------------------------------------------------------------------------
# GameQuery Discord Bot
#
# Copy to .env and fill in the four required values. Everything else has a
# sensible default; the full list lives in src/config.js.
#
# Never commit .env. It is in .gitignore for that reason.
# ---------------------------------------------------------------------------

# --- Required --------------------------------------------------------------

# Discord Developer Portal -> your application -> Bot -> Reset Token.
DISCORD_BOT_TOKEN=

# gamequery.dev API credentials. Free key: https://gamequery.dev/dashboard/keys
#
# These are not optional. The bot does not speak game protocols itself; every
# server reading comes from the gamequery.dev API, and the bot refuses to start
# without working credentials rather than reporting every server as unknown.
GAMEQUERY_API_TOKEN=
GAMEQUERY_API_EMAIL=
# Must match the key exactly: FREE or PRO.
GAMEQUERY_API_TYPE=FREE

# --- Database --------------------------------------------------------------

# An empty database is fine. The bot creates and migrates its own schema at
# boot; there is no separate migrate step.
DATABASE_URL=postgres://gamequery:changeme@postgres:5432/gamequery_bot

# Set true for a managed Postgres that terminates TLS with its own certificate.
DATABASE_SSL=false

# --- Optional --------------------------------------------------------------

# The API host. Note it is api.gamequery.dev, NOT gamequery.dev: the website
# answers unknown paths with HTML and a 200, so pointing this at the wrong host
# fails as a JSON parse error far from the cause.
GAMEQUERY_API_URL=https://api.gamequery.dev

# Where the bot draws its charts' text from. Charts still render without a
# font, but with nothing written on them.
FONT_DIR=/usr/share/fonts/dejavu

# GET /healthz reports the gateway connection, not just the process.
HEALTH_PORT=8081

# How often player history is sampled, and how often counters and live messages
# are rewritten. Discord rate-limits channel renames to twice per ten minutes
# per channel, so going below about 2 minutes buys nothing.
SAMPLER_INTERVAL_MINUTES=5
PRO_REFRESH_MINUTES=2

# 5-minute samples back the 24h and 7d charts; hourly rollups back 30d and 90d.
SAMPLE_RETENTION_DAYS=35
HOURLY_RETENTION_DAYS=400

# Leave this alone when self-hosting. `unlimited` turns every feature on, which
# is correct for a copy you run with your own API key, and means the bot never
# looks for the billing tables that only exist on the hosted instance.
PLAN_MODE=unlimited

# Verbose logging.
BOT_DEBUG=false
