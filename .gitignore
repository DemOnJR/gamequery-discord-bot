node_modules/
npm-debug.log*

# Real credentials. .env.example is the template that is committed.
.env
.env.*
!.env.example

# The bundled game catalogue IS committed: the Dockerfile copies it and a clone
# without it does not build. The bot refreshes it from the API at boot anyway,
# so the committed copy is only a starting point and a fallback.
data/*
!data/games.json

*.log
.DS_Store
